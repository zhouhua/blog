---
import weixin from '@assets/image/weixin.jpeg';
import Bio from '@components/Bio.astro';
import Container from '@components/Container.astro';
import { HOME } from '@consts';
import PageLayout from '@layouts/PageLayout.astro';
import { cn } from '@lib/utils';
import { ThemedRoughNotation } from '@react/components/ThemedRoughNotation';
import { Image } from 'astro:assets';
---

<style>
.card {
  box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.2);
}

:global(.dark) .card {
  box-shadow: inset 0 -1px 0 0 #ffffff1d;
}
</style>

<PageLayout description={HOME.DESCRIPTION} title={HOME.TITLE}>
  <Container>
    <div class="relative mx-auto max-w-[640px]">
      <div
        class={cn(
          'relative z-10 my-36 rounded-3xl',
          'colorModeTransition bg-card',
          'card',
        )}
      >
        <article
          class={cn('flex flex-col items-center px-8 py-12 sm:flex-row sm:items-start sm:justify-between sm:px-6 sm:py-6')}
        >
          <div class="mb-8 sm:mb-0 sm:absolute sm:left-1/2 sm:top-0 sm:-translate-x-1/2 sm:-translate-y-1/2">
            <Bio hideText />
          </div>
          <div class="flex flex-col justify-between leading-10 sm:h-80 sm:justify-around sm:pt-16">
            <div class="colorModeTransition text-center sm:text-left sm:ml-16">
              <h2 class="mb-4 mt-6 text-4xl">周骅</h2>
              <a href="mailto:zhou--hua@163.com">
                <ThemedRoughNotation
                  animationDelay={800}
                  client:only="react"
                  colorVar="--accent-foreground"
                  colorAlpha={0.2}
                  show
                  strokeWidth={2}
                  type="underline"
                >
                  zhou--hua@163.com
                </ThemedRoughNotation>
              </a>
            </div>
            <div class="font-serif text-sm leading-6 text-center sm:text-left">
              想成为⼀个有趣的⼈。
              <br />
              爱足球，爱桌游，
              <br />
              爱美食，爱⽣活。
              <br />
              爱钻研技术，更爱⽤技术改变产品；
              <br />
              爱解决问题，更爱提出问题。
            </div>
          </div>
          <Image
            alt="微信二维码"
            class="rounded-lg h-80 w-[241px] mt-8 sm:mt-0"
            height={640}
            src={weixin}
          />
        </article>
      </div>
    </div>
  </Container>
</PageLayout>
