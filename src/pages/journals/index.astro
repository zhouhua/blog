---
import Container from '@components/Container.astro';
import ListTitle from '@components/ListTitle.astro';
import { JOURNALS } from '@consts';
import PageLayout from '@layouts/PageLayout.astro';
import { getMarkdownExcerpt, getReadInfo } from '@lib/html';
import { getCollection } from 'astro:content';
import dayjs from 'dayjs';

const data = (await getCollection('journals')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const items = data.map((item) => {
  const year = item.data.date.getFullYear();
  const dateString = dayjs(item.data.date).format('MM-DD');
  const body = item.body || '';
  const { timeToRead, wordCount } = getReadInfo(body);
  const excerpt = getMarkdownExcerpt(body);
  return {
    dateString,
    excerpt,
    href: `/journal${year}-${dateString}`,
    timeToRead,
    truncated: excerpt.length >= 140,
    wordCount,
    year,
  };
});

const groups = new Map<number, typeof items>();
for (const item of items) {
  const entries = groups.get(item.year) ?? [];
  entries.push(item);
  groups.set(item.year, entries);
}
---

<PageLayout description={JOURNALS.DESCRIPTION} title={JOURNALS.TITLE}>
  <ListTitle
    description="随手记录不成熟的想法"
    title="周骅的博客 - 所有随笔"
  />
  <Container>
    {items.length === 0
      ? <p class="mt-8 text-zinc-500">还没有随笔。</p>
      : (
        <div class="mt-8 flex flex-col gap-10">
          {Array.from(groups.entries(), ([year, entries]) => (
            <section>
              <h2 class="text-2xl font-semibold">{year}</h2>
              <ul class="mt-4 flex flex-col gap-6">
                {entries.map(entry => (
                  <li>
                    <a class="text-sm text-zinc-500 hover:underline" href={entry.href}>{entry.dateString}</a>
                    {entry.excerpt && (
                      <a class="mt-1 block leading-7" href={entry.href}>
                        {entry.excerpt}{entry.truncated ? '…' : ''}
                      </a>
                    )}
                    <p class="mt-1 text-sm text-zinc-500">{entry.wordCount} 字 · {entry.timeToRead} 分钟</p>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}
  </Container>
</PageLayout>
